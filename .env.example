# ==============================================================================
# Nexus AI - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3000

# Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Supabase Credentials (Get yours at https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Service role key for elevated backend operations
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
